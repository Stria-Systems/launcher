{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stria Launcher",
  "version": "0.1.0",
  "identifier": "com.striasystems.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stria",
        "width": 960,
        "height": 680,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-P3AtWaSGywQQzxCQ5QSDHZpPfP46/816uSXB6+Xa0zA='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["stria"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage", "deb", "nsis"],
    "icon": ["icons/icon.png"]
  }
}
