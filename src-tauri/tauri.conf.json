{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stria Launcher",
  "version": "0.1.0",
  "identifier": "com.striasystems.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stria",
        "width": 760,
        "height": 560,
        "minWidth": 380,
        "minHeight": 320,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'sha256-EPibJPzWmAyiju8CTmU+i57g4pVxf93FHWi35TOvQJ4='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["stria"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "appimage", "deb", "nsis"],
    "icon": ["icons/icon.png"]
  }
}
